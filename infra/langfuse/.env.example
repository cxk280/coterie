# Copy to .env, regenerate the secrets (`openssl rand -hex 32`), then
# `docker compose up -d`.

# Public URL of the langfuse-web container (used by NextAuth for callbacks).
LANGFUSE_NEXTAUTH_URL=http://localhost:3001

# 32-byte hex strings — never reuse these dev defaults in any real deployment.
LANGFUSE_NEXTAUTH_SECRET=replace-me-with-openssl-rand-hex-32
LANGFUSE_SALT=replace-me-with-openssl-rand-hex-32
LANGFUSE_ENCRYPTION_KEY=replace-me-with-openssl-rand-hex-32

# Per-service passwords.
POSTGRES_PASSWORD=please-change-postgres
CLICKHOUSE_PASSWORD=please-change-clickhouse
REDIS_PASSWORD=please-change-redis
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=please-change-minio

# Auto-create an admin user + project on first boot — change before exposing
# the instance.
LANGFUSE_INIT_ORG_NAME=Coterie
LANGFUSE_INIT_ORG_ID=coterie
LANGFUSE_INIT_PROJECT_NAME=coterie
LANGFUSE_INIT_PROJECT_ID=coterie
LANGFUSE_INIT_USER_EMAIL=admin@coterie.local
LANGFUSE_INIT_USER_NAME=Coterie Admin
LANGFUSE_INIT_USER_PASSWORD=please-change-this-too

# Set to true to send anonymized usage metrics to langfuse.com.
LANGFUSE_TELEMETRY=false
