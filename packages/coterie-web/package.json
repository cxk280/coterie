{
  "name": "coterie-web",
  "version": "0.1.0",
  "description": "Web dashboard for Coterie — multi-mode LangGraph orchestration for heterogeneous coding agents.",
  "license": "MIT",
  "author": "Chris King <chris@cking.me>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "gen:api": "openapi-typescript ../coterie-api/openapi.json -o lib/api-types.ts",
    "gen:api:check": "npm run gen:api && git diff --exit-code lib/api-types.ts",
    "terminal:bridge": "node server/terminal-bridge.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "next": "^15.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1"
  }
}
