{
  "name": "coterie",
  "version": "0.5.0",
  "description": "Conversational meta-agent for your terminal: every prompt runs through a multi-agent coordination round (debate, adversarial, tournament, consensus) over Claude Code + Codex, on your subscriptions.",
  "license": "MIT",
  "author": "Chris King <chris@cking.me>",
  "homepage": "https://github.com/cxk280/coterie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cxk280/coterie.git",
    "directory": "packages/coterie-js"
  },
  "bugs": "https://github.com/cxk280/coterie/issues",
  "keywords": [
    "langgraph",
    "agents",
    "llm",
    "orchestration",
    "claude",
    "codex",
    "cursor"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "coterie": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/langgraph": "^0.2.0",
    "ajv": "^8.17.1",
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.14.0",
    "eslint": "^9.39.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^2.0.0"
  }
}
