{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coterie.dev/schemas/coterie.config.schema.json",
  "title": "Coterie configuration",
  "description": "Single source of truth for Coterie runtime configuration. The Python and JS runtimes both validate against this schema.",
  "type": "object",
  "required": ["agents"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Config schema version. Bumped on breaking changes."
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "description": "Coding-CLI agents available to the orchestrator. Order matters only as a default tiebreaker.",
      "items": {
        "type": "object",
        "required": ["id", "adapter"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Stable identifier used in routes, fan-out pairs, and judge outputs."
          },
          "adapter": {
            "type": "string",
            "enum": ["claude-code", "codex", "cursor", "aider", "shell"],
            "description": "Built-in adapter to use. `shell` lets you wrap an arbitrary CLI via the `command` template."
          },
          "command": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Required when adapter=shell. Argv template; supports `{prompt}` and `{workdir}` placeholders."
          },
          "model": {
            "type": "string",
            "description": "Optional model hint passed through to the adapter (e.g., `claude-opus-4-7`)."
          },
          "strengths": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Free-text capability hints surfaced to the supervisor (e.g., `planning`, `refactor`, `tests`)."
          },
          "timeout_s": {
            "type": "integer",
            "minimum": 10,
            "default": 600
          }
        }
      }
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "description": "Supervisor / routing behavior.",
      "properties": {
        "enabled": {"type": "boolean", "default": true},
        "model": {
          "type": "string",
          "default": "claude-haiku-4-5-20251001",
          "description": "Cheap model used for routing decisions."
        },
        "strategy": {
          "type": "string",
          "enum": ["llm", "round-robin", "manual"],
          "default": "llm"
        }
      }
    },
    "fanout": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional parallel fan-out: N agents race on the same task, then a judge picks a winner.",
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "pair": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "string"},
          "description": "Exactly two agent IDs that race. (N>2 racing is a future extension.)"
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {"type": "string", "default": "claude-opus-4-7"},
            "criteria": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["correctness", "minimal-diff", "tests-pass", "clarity", "speed"]
              },
              "default": ["correctness", "minimal-diff", "tests-pass", "clarity"]
            }
          }
        }
      }
    },
    "checkpoints": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "description": "Per-node HIL interrupt toggles. Keys are node names; `true` pauses before the node executes and waits for human approval.",
      "examples": [
        {
          "before_planner": false,
          "before_agent_run": true,
          "before_judge": false,
          "before_git_commit": true,
          "before_pytest": false
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_usd_per_task": {"type": "number", "minimum": 0},
        "warn_at_usd": {"type": "number", "minimum": 0},
        "on_exceed": {
          "type": "string",
          "enum": ["halt", "warn", "checkpoint"],
          "default": "checkpoint"
        }
      }
    },
    "tools": {
      "type": "array",
      "description": "Deterministic dev tools registered as graph nodes (pytest, ruff, git, etc.).",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "kind": {
            "type": "string",
            "enum": ["pytest", "vitest", "ruff", "eslint", "git", "shell"]
          },
          "args": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["none", "langfuse", "langsmith", "file"],
          "default": "file"
        },
        "log_dir": {"type": "string", "default": ".coterie/logs"}
      }
    },
    "workdir": {
      "type": "string",
      "description": "Working directory agents operate on. Defaults to CWD.",
      "default": "."
    }
  }
}
