{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coterie.dev/schemas/coterie.config.schema.json",
  "title": "Coterie configuration",
  "description": "Single source of truth for Coterie runtime configuration. The Python and JS runtimes both validate against this schema.",
  "type": "object",
  "required": ["mode", "agents"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "const": 1},
    "mode": {
      "type": "string",
      "enum": ["single", "consensus", "adversarial", "debate", "tournament"],
      "description": "Coordination pattern. Each mode wires a different LangGraph topology. See docs/modes.md."
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "adapter"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "adapter": {
            "type": "string",
            "enum": ["claude-code", "codex", "cursor", "aider", "shell", "fake"]
          },
          "command": {"type": "array", "items": {"type": "string"}},
          "model": {"type": "string"},
          "strengths": {"type": "array", "items": {"type": "string"}},
          "timeout_s": {"type": "integer", "minimum": 10, "default": 600}
        }
      }
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "description": "Used in `single` mode to pick which agent handles each subtask.",
      "properties": {
        "enabled": {"type": "boolean", "default": true},
        "model": {"type": "string", "default": "claude-haiku-4-5-20251001"},
        "strategy": {
          "type": "string",
          "enum": ["llm", "round-robin", "manual"],
          "default": "llm"
        }
      }
    },
    "single": {
      "type": "object",
      "additionalProperties": false,
      "description": "Single-routed mode: router picks one agent per subtask."
    },
    "consensus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "participants": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 2
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {"type": "string", "default": "claude-opus-4-7"},
            "confirm_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5
            }
          }
        }
      }
    },
    "adversarial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementer", "auditor"],
      "properties": {
        "implementer": {"type": "string"},
        "auditor": {"type": "string"},
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {"type": "string", "default": "claude-opus-4-7"},
            "sustain_threshold": {
              "type": "string",
              "enum": ["low", "medium", "high"],
              "default": "medium"
            }
          }
        },
        "max_rounds": {"type": "integer", "minimum": 1, "default": 3}
      }
    },
    "debate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sides"],
      "properties": {
        "sides": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "string"}
        },
        "rounds": {"type": "integer", "minimum": 1, "default": 3},
        "moderator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {"type": "string", "default": "claude-haiku-4-5-20251001"}
          }
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {"type": "string", "default": "claude-opus-4-7"}
          }
        }
      }
    },
    "tournament": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participants"],
      "properties": {
        "participants": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string"}
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {"type": "string", "default": "claude-opus-4-7"},
            "criteria": {
              "type": "array",
              "items": {"type": "string"},
              "default": ["correctness", "minimal-diff", "tests-pass", "clarity"]
            }
          }
        }
      }
    },
    "checkpoints": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_usd_per_task": {"type": "number", "minimum": 0},
        "warn_at_usd": {"type": "number", "minimum": 0},
        "on_exceed": {
          "type": "string",
          "enum": ["halt", "warn", "checkpoint"],
          "default": "checkpoint"
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "kind": {
            "type": "string",
            "enum": ["pytest", "vitest", "ruff", "eslint", "git", "shell"]
          },
          "args": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["none", "langfuse", "langsmith", "file"],
          "default": "file"
        },
        "log_dir": {"type": "string", "default": ".coterie/logs"}
      }
    },
    "workdir": {"type": "string", "default": "."}
  }
}
