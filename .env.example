# Coterie deployment env. Copy to .env and fill in the secrets you actually need.

# ---------- API ----------
# Default daily budget cap per non-admin user (USD).
COTERIE_DEFAULT_DAILY_CAP_USD=5.00

# Host port mappings. Internal containers always listen on 8000 / 3000.
COTERIE_API_PORT_HOST=8000
COTERIE_WEB_PORT_HOST=3000

# CORS allowlist (comma-separated). Whatever origin coterie-web is served on.
COTERIE_CORS_ORIGINS=http://localhost:3000

# ---------- LLM providers ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# ---------- Observability (self-hosted Langfuse — see infra/langfuse/) ----------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- GitHub OAuth (optional) ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
COTERIE_WEB_BASE=http://localhost:3000

# ---------- Web → API auth ----------
# Either token is fine; NEXT_PUBLIC_ is browser-visible (dev only).
COTERIE_API_TOKEN=
NEXT_PUBLIC_COTERIE_API_TOKEN=
NEXT_PUBLIC_COTERIE_API_URL=http://localhost:8000
